# Choose one provider in the app sidebar.

# OpenAI-compatible provider
OPENAI_API_KEY=put_your_openai_key_here
OPENAI_API_BASE=
CLIP_FINDER_MODEL=gpt-5-mini

# NVIDIA NIM provider
# Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=put_your_nvidia_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
